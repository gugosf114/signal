<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:navigationBarColor">#08090A</item>
        <item name="android:statusBarColor">#08090A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.CardScanner" parent="AppTheme.NoActionBar">
        <item name="android:windowAnimationStyle">@style/CardScannerWindowAnimation</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="CardScannerWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/scanner_no_animation</item>
        <item name="android:activityOpenExitAnimation">@anim/scanner_no_animation</item>
        <item name="android:activityCloseEnterAnimation">@anim/scanner_no_animation</item>
        <item name="android:activityCloseExitAnimation">@anim/scanner_no_animation</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#08090A</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
